<Window x:Class="CharacterLauncher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Orbit" Icon="/Z-Orbit;component/assets/app-icon.ico"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False" Topmost="True" WindowState="Maximized" KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="Backdrop" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Border x:Name="BackgroundLayer" Background="{DynamicResource StageBackground}" />
        <StackPanel x:Name="BrandHeader" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,28,0,0" IsHitTestVisible="False">
            <Image Source="/Z-Orbit;component/assets/app-icon-rounded20.png" Width="32" Height="32" />
            <TextBlock Text="Z-Orbit" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <Button x:Name="HideButton" Content="×" Click="Hide_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,32,0"
                Width="42" FontSize="22" Padding="0" ToolTip="{DynamicResource L042}" AutomationProperties.Name="{DynamicResource L043}" />
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="28,92,28,108">
            <Grid Width="1160" Height="460">
                <Grid.RowDefinitions><RowDefinition Height="360" /><RowDefinition Height="100" /></Grid.RowDefinitions>
                <Border x:Name="SelectionFrame" Width="286" Height="286" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,6,0,0" CornerRadius="26" BorderThickness="1" BorderBrush="{DynamicResource Accent}"
                        Background="Transparent" Opacity="0.45" IsHitTestVisible="False" />
                <Canvas x:Name="CarouselCanvas" Grid.Row="0" Height="360" />
                <TextBlock x:Name="SelectedName" Grid.Row="1" Foreground="{DynamicResource Text}" FontSize="36"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"
                           TextOptions.TextFormattingMode="Display" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Viewbox>
        <TextBlock x:Name="UsageHint" TextWrapping="Wrap" MaxWidth="780" Text="{DynamicResource L044}" Foreground="{DynamicResource Muted}" FontSize="13"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,42" />
        <Button x:Name="ManageAppsButton" Content="{DynamicResource L002}" Click="ManageApps_Click" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,36,28" MinWidth="144" Height="48" FontSize="15"
                BorderBrush="{DynamicResource Accent}" AutomationProperties.Name="{DynamicResource L045}" />
    </Grid>
</Window>
